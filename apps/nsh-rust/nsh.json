{
  "name": "MoonTVPlus Rust",
  "id": "com.moontvplus.phone",
  "version": "1.9.22",
  "build": 32,
  "rust": ".",
  "root": "App",
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "audio": true,
    "openUrl": {
      "schemes": [
        "https"
      ]
    },
    "fs": {
      "read": [
        "${dataDir}"
      ],
      "write": [
        "${dataDir}"
      ]
    },
    "application": true
  },
  "android": {
    "usesCleartextTraffic": true,
    "permissions": [
      "REQUEST_INSTALL_PACKAGES"
    ]
  }
}
