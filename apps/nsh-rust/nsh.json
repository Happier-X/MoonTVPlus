{
  "name": "MoonTVPlus Rust",
  "id": "com.example.moontvplusrust",
  "version": "1.0.0",
  "build": 1,
  "rust": ".",
  "root": "App",
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "audio": true,
    "openUrl": {
      "schemes": [
        "https"
      ]
    },
    "fs": {
      "read": [
        "${dataDir}"
      ],
      "write": [
        "${dataDir}"
      ]
    }
  },
  "android": {
    "usesCleartextTraffic": true
  }
}
